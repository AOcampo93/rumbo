# Template for apps/api/.env (local development; git ignores that file).
# Production values live in Coolify as runtime-only variables.
# Never commit real values: this repository is public.

# --- Server ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Database (secret) ---
# postgres://user:password@localhost:5432/rumbo. Leave empty to run without a database.
DATABASE_URL=

# --- Generative AI, phase 7 (secret) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET_USD=5
AI_MAX_GENERATIONS_PER_DEVICE_PER_DAY=40

# --- Place search, phase 6 (secret) ---
# Server-side ArcGIS key for address search; never the same key as the web's.
ARCGIS_API_KEY_SERVER=
GEOCODING_PROVIDER=wikidata

# --- Wikimedia, phase 7 ---
# Wikimedia requires a descriptive User-Agent with a contact email.
# Keep the real email out of the repo, e.g. "Rumbo/0.1 (contact: <email>)".
WIKIMEDIA_USER_AGENT=

# --- Analytics ---
ANALYTICS_ENABLED=true
