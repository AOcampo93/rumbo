# Template for apps/api/.env (local development; git ignores that file).
# Production values live in Coolify as runtime-only variables.
# Never commit real values: this repository is public.

# --- Server ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Requests per minute per device (or IP) across the API. Default 300.
RATE_LIMIT_PER_MINUTE=300
# Stricter limits per client IP (the device id is the client's choice):
# route writes (POST/PUT/DELETE /routes, owner reads of a user route) per
# minute and per day, and place searches per minute.
WRITE_RATE_LIMIT_PER_MINUTE=20
WRITE_RATE_LIMIT_PER_DAY=200
GEO_RATE_LIMIT_PER_MINUTE=120
# User routes the server keeps at most; past it, new ones get 503. Each
# device may keep 50.
USER_ROUTES_MAX=5000

# --- Database (secret) ---
# postgres://user:password@localhost:5432/rumbo. Leave empty to run without a database.
# On start the API applies pending migrations (apps/api/drizzle) and loads the
# curated routes of data/routes.
DATABASE_URL=

# --- Generative AI, phase 7 (secret) ---
# anthropic, or empty to turn the AI off (POST /content/generate and
# /suggest/places then answer 503 ai_unavailable). anthropic needs AI_API_KEY.
AI_PROVIDER=
AI_API_KEY=
# Empty: claude-sonnet-5-5.
AI_MODEL=
# How hard the model thinks: low (default), medium, high, or none to send no
# setting (for models that don't take one).
AI_EFFORT=low
# Estimated spend (USD) per UTC day after which no new generation starts
# (429 ai_budget_exceeded), and generations one device may start per UTC day
# (429 ai_device_limit). Answers served from the cache are free.
AI_DAILY_BUDGET_USD=5
AI_MAX_GENERATIONS_PER_DEVICE_PER_DAY=40
# The prices behind that estimate: USD per million tokens, and per web search.
# Defaults are claude-sonnet-5-5's; change them together with AI_MODEL.
AI_PRICE_INPUT_PER_MTOK=2
AI_PRICE_OUTPUT_PER_MTOK=10
AI_PRICE_PER_WEB_SEARCH=0.01
# Stricter limits per client IP: card generations and place suggestions per minute.
CONTENT_RATE_LIMIT_PER_MINUTE=30
SUGGEST_RATE_LIMIT_PER_MINUTE=20

# --- Place search, phase 6 ---
# wikidata (default) or none (GET /geo/* answers 503 geocoding_unavailable).
GEOCODING_PROVIDER=wikidata
# Wikimedia requires a descriptive User-Agent with contact details; the place
# search and the research behind the AI cards both send it. Empty:
# "Rumbo/<version> (https://github.com/AOcampo93/rumbo)". To give an email,
# set it in Coolify; keep it out of the repo.
WIKIMEDIA_USER_AGENT=
# (secret) Server-side ArcGIS key for address search, not used yet; never the
# same key as the web's.
ARCGIS_API_KEY_SERVER=

# --- Analytics ---
# false: batches are accepted (202) but not stored.
ANALYTICS_ENABLED=true
