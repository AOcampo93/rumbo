# Template for apps/web/.env (local development; git ignores that file).
# Every VITE_* variable is embedded in the public JavaScript bundle, so anyone
# can read it: never put secrets here. Server-side keys belong in apps/api/.env.

# ArcGIS key for basemaps only, restricted by HTTP referrer
# (production domain + localhost) in the ArcGIS dashboard.
VITE_ARCGIS_API_KEY=
VITE_DEFAULT_BASEMAP=arcgis/navigation
